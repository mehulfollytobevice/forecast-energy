# Copy to .env and fill in values. Never commit real keys.
# PJM Data Miner subscription key: https://apiportal.pjm.com/profile
PJM_API_KEY=

# Open-Meteo commercial API key (Professional+ for Single Runs).
# https://open-meteo.com/en/pricing — leave empty to use the free non-commercial tier.
OPEN_METEO_API_KEY=

# Optional. Defaults to sqlite:///mlflow.db at the repository root.
# MLFLOW_TRACKING_URI=

# Optional dashboard snapshots (API falls back to processed path, then fixtures).
# FORECAST_SNAPSHOT=app/fixtures/forecast_snapshot.json
# BACKTEST_SNAPSHOT=app/fixtures/backtest_snapshot.json

# Optional S3-compatible object storage (omit for local data/ filesystem mode).
# S3_BUCKET=
# S3_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
